# Copy this file to the root of the isolated HERMES_HOME created by
# install-local.sh. These keys match Hermes v2026.8.3's canonical config.
model:
  default: openai/gpt-5.6-luna
  provider: openrouter
agent:
  reasoning_effort: max
plugins:
  enabled:
    - urbana-domain
platform_toolsets:
  api_server:
    - urbana-domain
    - no_mcp
memory:
  memory_enabled: false
  user_profile_enabled: false
