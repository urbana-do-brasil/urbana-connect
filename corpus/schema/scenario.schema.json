{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fixtures.urbana.local/hermes/scenario.schema.json",
  "title": "Hermes local corpus scenario",
  "type": "object",
  "required": ["id", "name", "purpose", "contactAlias", "events"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "contactAlias": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "fixtures": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^poc/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*(?:\\.[A-Za-z0-9_-]+)?$" }
    },
    "persona": { "type": "string", "minLength": 1 },
    "memory": { "$ref": "#/$defs/memory" },
    "events": { "$ref": "#/$defs/eventList" },
    "approval": { "$ref": "#/$defs/approval" },
    "isolationSentinel": { "$ref": "#/$defs/isolationSentinel" },
    "returnToAi": { "type": "boolean" }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1
    },
    "event": {
      "type": "object",
      "required": ["eventId", "type", "occurredAt", "assertions"],
      "additionalProperties": false,
      "properties": {
        "eventId": { "type": "string", "minLength": 1 },
        "type": { "enum": ["TEXT", "AUDIO", "IMAGE", "DOCUMENT", "INTERACTIVE", "PAYMENT_PROOF"] },
        "text": { "type": "string" },
        "transcript": { "type": "string" },
        "mediaFixture": {
          "type": "string",
          "pattern": "^poc/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*(?:\\.[A-Za-z0-9_-]+)?$"
        },
        "interactiveReplyId": { "type": "string" },
        "occurredAt": { "type": ["string", "number"], "format": "date-time" },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion" }
        }
      }
    },
    "eventList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    },
    "fact": {
      "type": "object",
      "required": ["type", "value", "confidence", "sourceMessageId"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["CONFIRMED", "TENTATIVE"] },
        "sourceMessageId": { "type": "string", "minLength": 1 }
      }
    },
    "memory": {
      "type": "object",
      "required": ["facts"],
      "additionalProperties": false,
      "properties": {
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fact" }
        },
        "setupEvents": {
          "type": "array",
          "items": { "$ref": "#/$defs/event" }
        }
      }
    },
    "approval": {
      "type": "object",
      "required": ["endpoint", "assertions"],
      "additionalProperties": false,
      "properties": {
        "endpoint": { "type": "string", "pattern": "^/api/poc/conversations/[A-Za-z0-9_-]+/payment-proof/approve$" },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion" }
        }
      }
    },
    "isolationSentinel": {
      "type": "object",
      "required": ["contactAlias", "memory", "events"],
      "additionalProperties": false,
      "properties": {
        "contactAlias": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "memory": { "$ref": "#/$defs/memory" },
        "events": { "$ref": "#/$defs/eventList" }
      }
    }
  }
}
